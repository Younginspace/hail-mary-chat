# Web client build-time env vars.
# Copy this file to .env.development.local (gitignored) and uncomment
# what you want enabled in your local dev build.

# Companion mode v1 — entry CTAs ("STAY CONNECTED" on home, "🛰" in chat).
# Default false in prod. Flip to true here for local dev to see them.
# Flip to true in EdgeSpark's prod build env after real asset mp3s
# land in web/public/audio/companion/v1/ (replacing placeholders).
# VITE_COMPANION_ENABLED=true
